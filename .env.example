# SethuCMS gateway: OPTIONAL direct access, normally leave all of these blank.
# The app loads the catalog through the DesignWear API, which holds the CMS credentials
# in its own private .env (designwear-server/.env). Do not put a CMS token here: this
# file is bundled into the app (and is publicly downloadable on web).
SETHUCMS_URL=
SETHUCMS_CONNECTION_ID=
SETHUCMS_VIEWER_TOKEN=
SETHUCMS_INTERNAL_URL=
SETHUCMS_INTERNAL_CONNECTION_ID=
SETHUCMS_INTERNAL_VIEWER_TOKEN=

# DesignWear API (accounts, orders, community designs, AI). Leave empty to run
# fully on-device. External flavour, then internal:
DESIGNWEAR_API_URL=
DESIGNWEAR_INTERNAL_API_URL=

# Google sign-in via Firebase Auth (optional; the button is hidden until this is
# filled in for the platform you run on). Firebase console -> Project settings
# -> Your apps. Needs DESIGNWEAR_API_URL too: the API verifies the Google login.
# Internal flavour uses the same keys with a FIREBASE_INTERNAL_ prefix.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_BUNDLE_ID=

# Shop numbers (all optional; the defaults are in lib/config/shop_config.dart).
# Keep TAX_RATE, CLOTHING_SIZES, ONE_SIZE_LABEL and LOW_STOCK_AT in step with the API.
# TAX_RATE=0.18
# CLOTHING_SIZES=S,M,L,XL,XXL
# ONE_SIZE_LABEL=One size
# LOW_STOCK_AT=5
# CATALOG_PAGE_SIZE=40
# SEARCH_PAGE_SIZE=200
# WATCH_SMALL_BELOW_MM=38
# WATCH_LARGE_ABOVE_MM=42
