# SethuCMS gateway (the app reads content through it; DB credentials live only
# on the gateway). Use a READ-ONLY viewer token: it ships inside the app.
# External flavour:
SETHUCMS_URL=
SETHUCMS_CONNECTION_ID=
SETHUCMS_VIEWER_TOKEN=
# Internal flavour (optional second gateway/connection):
SETHUCMS_INTERNAL_URL=
SETHUCMS_INTERNAL_CONNECTION_ID=
SETHUCMS_INTERNAL_VIEWER_TOKEN=

# DesignWear API (accounts, orders, community designs, AI). Leave empty to run
# fully on-device. External flavour, then internal:
DESIGNWEAR_API_URL=
DESIGNWEAR_INTERNAL_API_URL=

# Google sign-in via Firebase Auth (optional; the button is hidden until this is
# filled in for the platform you run on). Firebase console -> Project settings
# -> Your apps. Needs DESIGNWEAR_API_URL too: the API verifies the Google login.
# Internal flavour uses the same keys with a FIREBASE_INTERNAL_ prefix.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_BUNDLE_ID=
